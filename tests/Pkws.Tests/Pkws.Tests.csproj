<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);xUnit1051;xUnit2013</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Pkws.Core/Pkws.Core.csproj" />
    <ProjectReference Include="../../src/Pkws.Api/Pkws.Api.csproj" />
    <ProjectReference Include="../../src/Pkws.Agent/Pkws.Agent.csproj" />
  </ItemGroup>
</Project>
