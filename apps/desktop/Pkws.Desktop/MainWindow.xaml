<Window x:Class="Pkws.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PKWS" Width="540" Height="820" MinWidth="420" MinHeight="560"
        WindowStartupLocation="Manual" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <Style x:Key="ModernIconButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#5F5851" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#F0EAE4" />
                                <Setter Property="Foreground" Value="#2B2724" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E4D9CF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MarkdownToolButton" TargetType="Button">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#6D655E" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ToolSurface" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolSurface" Property="Background" Value="#F0EAE4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToolSurface" Property="Background" Value="#E4D9CF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#FFFCF9" BorderBrush="#E5DDD4" BorderThickness="1" CornerRadius="16" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="今天" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock x:Name="DateText" Margin="0,2,0,0" FontSize="26" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="SettingsButton" Style="{StaticResource ModernIconButton}"
                            Margin="0,0,6,0" ToolTip="设置" Click="SettingsButton_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Data="M3,6 H9 M15,6 H21 M12,3 V9 M3,12 H14 M20,12 H21 M17,9 V15 M3,18 H5 M11,18 H21 M8,15 V21"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource ModernIconButton}" ToolTip="收起到屏幕右侧" Click="CollapseButton_Click">
                        <Viewbox Width="20" Height="20">
                            <Path Data="M9,5 L16,12 L9,19"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="NotesScrollViewer" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="NotesScrollViewer_PreviewMouseWheel">
                <StackPanel>
                    <StackPanel x:Name="NoteBlocksPanel" />
                    <StackPanel x:Name="DraftBlock" Margin="0,4,0,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DraftHourText" VerticalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#A56539" />
                            <Button x:Name="PreviewToggleButton" Grid.Column="1"
                                    Style="{StaticResource MarkdownToolButton}" Margin="0"
                                    Content="预览" Click="PreviewToggleButton_Click" />
                        </Grid>
                        <StackPanel x:Name="MarkdownToolbar" Margin="0,10,0,1" Orientation="Horizontal">
                            <Button Style="{StaticResource MarkdownToolButton}" Content="H" FontWeight="SemiBold"
                                    ToolTip="标题" Click="HeadingButton_Click" />
                            <Button Style="{StaticResource MarkdownToolButton}" Content="B" FontWeight="Bold"
                                    ToolTip="粗体（Ctrl+B）" Click="BoldButton_Click" />
                            <Button Style="{StaticResource MarkdownToolButton}" Content="I" FontStyle="Italic"
                                    ToolTip="斜体（Ctrl+I）" Click="ItalicButton_Click" />
                            <Button Style="{StaticResource MarkdownToolButton}" Content="•" FontSize="18"
                                    ToolTip="列表" Click="ListButton_Click" />
                            <Button Style="{StaticResource MarkdownToolButton}" Content="❯"
                                    ToolTip="引用" Click="QuoteButton_Click" />
                            <Button Style="{StaticResource MarkdownToolButton}" Content="&lt;/&gt;"
                                    ToolTip="代码" Click="CodeButton_Click" />
                        </StackPanel>
                        <TextBox x:Name="InputBox" Margin="0,7,0,0" Padding="0" MinHeight="180"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Disabled" BorderThickness="0"
                                 Background="Transparent" FontSize="16" SpellCheck.IsEnabled="False"
                                 TextChanged="InputBox_TextChanged" />
                        <FlowDocumentScrollViewer x:Name="DraftPreview" Margin="0,10,0,0" MinHeight="180"
                                                  Visibility="Collapsed" IsToolBarVisible="False"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  Background="Transparent" BorderThickness="0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               Text="Markdown" TextWrapping="Wrap" />
                    <TextBlock x:Name="DraftNoticeText" Margin="0,3,0,0" Foreground="#A56539"
                               FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="SaveButton" Grid.Column="1" Width="44" Height="44" Padding="0" Margin="12,0,0,0"
                        Content="↑" FontSize="22" Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderThickness="0" ToolTip="保存（Ctrl+Enter）" Click="SaveButton_Click" />
            </Grid>

            <Border x:Name="SettingsPanel" Grid.RowSpan="3" Panel.ZIndex="10" Width="340"
                    Margin="0,48,0,0" Padding="18" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="White" BorderBrush="#DED5CB" BorderThickness="1" CornerRadius="12"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="文档位置" FontSize="13" FontWeight="SemiBold" />
                    <TextBox x:Name="DocumentPathBox" Margin="0,8,0,12" Padding="8" IsReadOnly="True"
                             TextWrapping="Wrap" BorderBrush="#E5DDD4" Background="#FAF7F3" FontSize="12" />
                    <TextBlock Margin="0,0,0,12"
                               Text="笔记固定保存在程序目录的 doc 文件夹；运行状态仍保存在本机应用数据目录。"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    <Button Margin="0,0,0,8" Content="打开 doc 文件夹" Click="OpenDocumentFolderButton_Click" />
                    <Border Margin="0,6,0,12" BorderBrush="#EEE7DF" BorderThickness="0,1,0,0" />
                    <TextBlock Text="Chrome 插件" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,9" Text="生成一次性配对码，在插件侧栏中输入。配对码 5 分钟后失效。"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PairingCodeText" VerticalAlignment="Center" FontSize="22"
                                   FontWeight="SemiBold" FontFamily="Consolas" Text="—— —— ——" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="12,6"
                                Content="生成配对码" Click="CreatePairingCodeButton_Click" />
                    </Grid>
                    <Button Margin="0" Content="退出 PKWS" Click="ExitButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
