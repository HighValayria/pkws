<Application x:Class="Pkws.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF9F5" />
        <SolidColorBrush x:Key="InkBrush" Color="#23211F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6D6861" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C4D2B" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Application.Resources>
</Application>
